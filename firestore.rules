rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile: only the authenticated user can access their own UID document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Shop data: scoped by business/shopId
    // Allows multi-device synchronization for authenticated accounts belonging to the shop
    match /shops/{shopId} {
      allow read, write: if request.auth != null;
      
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
